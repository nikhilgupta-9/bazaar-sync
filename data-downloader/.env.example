# data-downloader/.env  — copy to .env and fill in by hand (never commit .env)
# ---------------------------------------------------------------------------

# === MySQL — where all downloaded data is written ===
# Point this at the main app's database (remote host + a DB user that can
# reach it), or at a local MySQL on this machine. The tables written are
# listed in config/schema.sql.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bazaar_sync
DB_USER=root
DB_PASSWORD=

# === Angel One SmartAPI — LIVE WebSocket tick feed (workers/marketWorker.js) ===
# Required only if you run `npm run worker`. TOTP is generated automatically
# from the secret via otplib — there is NO daily manual login step.
#   ANGEL_API_KEY     — smartapi.angelbroking.com -> My Apps -> API key
#   ANGEL_CLIENT_ID   — your Angel One client code
#   ANGEL_PASSWORD    — your SmartAPI login PIN (not a password, not a TOTP code)
#   ANGEL_TOTP_SECRET — the base32 QR secret from smartapi.angelbroking.com/enable-totp
#                       (the secret string, NOT a 6-digit code)
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# === Upstox — historical backfill (scripts/backfillUpstox.js) ===
# Expired-instruments endpoints need the Upstox PLUS plan. Token is minted via
# a one-time OAuth browser flow at account.upstox.com/developer/apps and does
# NOT auto-refresh — when it 401s, log in again and paste a fresh one here.
UPSTOX_ACCESS_TOKEN=
UPSTOX_CLIENT_ID=

# === ICICI Breeze — historical backfill (breeze-historical/backfillBreeze.js) ===
# BREEZE_API_SESSION EXPIRES DAILY and must be regenerated by hand each day
# you run a Breeze backfill — see breeze-historical/README.md for the exact
# login-URL steps. There is no automatic option (unlike Angel One).
BREEZE_API_KEY=
BREEZE_API_SECRET=
BREEZE_API_SESSION=

# === Optional tuning (defaults shown) ===
# WORKER_SYMBOLS=NIFTY,BANKNIFTY,FINNIFTY
# WORKER_STRIKES_PER_SIDE=15
# TICK_BUFFER_MAX_RECORDS=100
# TICK_BUFFER_FLUSH_MS=2000
# LOG_LEVEL=info
# CONSOLE_LOG_LEVEL=info
#
# ANGEL_TOKEN_NIFTY=99926000
# ANGEL_TOKEN_BANKNIFTY=99926009
# ANGEL_TOKEN_FINNIFTY=99926037
# ANGEL_TOKEN_INDIAVIX=99926017
#
# UPSTOX_REQUEST_GAP_MS=1200
# UPSTOX_BACKFILL_LOOKBACK_DAYS=35
#
# Upstox index instrument_key overrides (7-index goal). Defaults are best-
# effort; if backfillUpstoxYear.js reports "no-data / 0 expiries" for one of
# these, find the exact key in Upstox's instrument master and set it here.
# UPSTOX_KEY_NIFTY=NSE_INDEX|Nifty 50
# UPSTOX_KEY_BANKNIFTY=NSE_INDEX|Nifty Bank
# UPSTOX_KEY_FINNIFTY=NSE_INDEX|Nifty Fin Service
# UPSTOX_KEY_MIDCPNIFTY=NSE_INDEX|NIFTY MID SELECT
# UPSTOX_KEY_NIFTYNXT50=NSE_INDEX|Nifty Next 50
# UPSTOX_KEY_SENSEX=BSE_INDEX|SENSEX
# UPSTOX_KEY_BANKEX=BSE_INDEX|BANKEX
#
# Force an exact fixed symbol universe (one symbol per line, # comments ok)
# instead of deriving the F&O stock list from the Angel scrip master:
# UNIVERSE_FILE=/absolute/path/to/symbols.txt
# BREEZE_DAILY_CALL_LIMIT=4800
# BREEZE_PER_MINUTE_LIMIT=90
# BREEZE_CHUNK_DAYS=2
# BREEZE_STOCKCODE_BANKNIFTY=CNXBAN
# BREEZE_STOCKCODE_FINNIFTY=NIFFIN
