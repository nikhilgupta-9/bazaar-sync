# data-downloader/.env.example — copy to .env and fill in real values BY HAND.
# Never commit .env. Never paste real secrets into chat.

# --- Database (same MySQL as the main app) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bazaar_sync
DB_USER=root
DB_PASSWORD=

# --- ICICI Breeze (option-chain + India VIX historical) ---
# BREEZE_API_SESSION expires DAILY. Get a fresh one:
#   1. open  https://api.icicidirect.com/apiuser/login?api_key=<url-encoded BREEZE_API_KEY>
#   2. log in, copy the apisession=<value> from the redirect URL
#   3. paste it below, then run the pipeline (valid that day only)
BREEZE_API_KEY=
BREEZE_API_SECRET=
BREEZE_API_SESSION=

# --- Optional Breeze overrides (only if a run stores 0 rows for a symbol) ---
# Index option stock codes (unverified defaults in breeze/symbolMap.js):
#BREEZE_STOCKCODE_BANKNIFTY=CNXBAN
#BREEZE_STOCKCODE_FINNIFTY=NIFFIN
#BREEZE_STOCKCODE_MIDCPNIFTY=NIFMDCP50
#BREEZE_STOCKCODE_NIFTYNXT50=NIFTYNXT50
#BREEZE_STOCKCODE_SENSEX=BSESEN
#BREEZE_STOCKCODE_BANKEX=BANKEX
# India VIX (unverified defaults in vix/vixHistorical.js):
#BREEZE_VIX_STOCKCODE=INDIAVIX
#BREEZE_VIX_EXCHANGE=NSE
#BREEZE_VIX_PRODUCT=cash

# --- Optional rate-limit / pacing tuning ---
#BREEZE_DAILY_CALL_LIMIT=4800
#BREEZE_PER_MINUTE_LIMIT=90
#BREEZE_CHUNK_DAYS=2
#BHAVCOPY_DAY_GAP_MS=2500
#VIX_MIN_CANDLES_PER_DAY=300

# --- Dhan API v2 (2023+ minute-level option chain + index/VIX + daily futures) ---
# DHAN_ACCESS_TOKEN should be a personal long-lived token (Dhan app: Profile
# -> DhanHQ Trading APIs -> Generate Token), NOT a partner/consent token —
# those expire in 24h (confirmed for real, see dhan/client.js's header).
DHAN_ACCESS_TOKEN=
DHAN_CLIENT_ID=

# --- Optional Dhan tuning (see dhan/enrichOptions.js, dhan/client.js) ---
#DHAN_MAX_REQ_PER_SEC=6
#DHAN_MAX_RETRIES=5
#DHAN_INTRADAY_CHUNK_DAYS=80
#DHAN_WEEKLY_RANKS=6
#DHAN_MONTHLY_RANKS=3
#DHAN_INDEX_STRIKE_OFFSETS=10
#DHAN_STOCK_STRIKE_OFFSETS=3
