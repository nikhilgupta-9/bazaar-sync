PORT=5001

JWT_SECRET=

# --- Angel One SmartAPI (sole market data source since Phase 6) ---
# All four are required. TOTP is generated automatically from the secret via
# otplib — there is NO daily manual login step.
# ANGEL_API_KEY      — from smartapi.angelbroking.com (My Apps -> API key)
# ANGEL_CLIENT_ID    — your Angel One client code
# ANGEL_PASSWORD     — your SmartAPI login PIN
# ANGEL_TOTP_SECRET  — the base32 secret shown when enabling TOTP at
#                      smartapi.angelbroking.com/enable-totp (the QR-code
#                      secret, NOT a 6-digit code)
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# --- Kotak Neo Trade API (SECOND live source, added 2026-09-10 — runs
#     ALONGSIDE Angel One, does NOT replace it. Standalone poller:
#     `npm run kotak`. Covers all 7 F&O indices + the ~210 F&O stocks.
#     Writes option chains -> option_chain_history and spot/India VIX/futures
#     -> ohlcv_data. Kotak has NO historical API — the poller is the forward
#     historian. See server/kotak/README.md) ---
# KOTAK_CONSUMER_KEY / KOTAK_CONSUMER_SECRET — from Kotak Neo web/app:
#     Invest -> Trade API -> API Dashboard -> Create Application
# KOTAK_MOBILE     — registered mobile in E.164, e.g. +9199XXXXXXXX
# KOTAK_UCC        — your Unique Client Code (client/trading code)
# KOTAK_MPIN       — the 6-digit MPIN you set for the API
# KOTAK_TOTP_SECRET— base32 seed from TOTP registration
#     (kotakneo.com/platform/kotak-neo-trade-api/totp-registration/),
#     NOT a rotating 6-digit code. Login is then fully automatic.
KOTAK_CONSUMER_KEY=
KOTAK_CONSUMER_SECRET=
KOTAK_MOBILE=
KOTAK_UCC=
KOTAK_MPIN=
KOTAK_TOTP_SECRET=
# Optional Kotak tuning (defaults shown):
# KOTAK_MODE=all                     — all | index | stock (run 2 processes to split tiers)
# KOTAK_STOCKS=auto                  — auto (every F&O stock) | CSV list of symbols
# KOTAK_STOCKS_EXCLUDE=              — CSV symbols to skip in auto mode
# KOTAK_INDEX_INTERVAL_MS=15000      — index-chain refresh cadence
# KOTAK_INDEX_STRIKES=20             — strikes each side of ATM (indices)
# KOTAK_STOCK_STRIKES=10             — strikes each side of ATM (stocks)
# KOTAK_STOCK_SWEEP_MS=300000        — target time for one full trip around all stocks
# KOTAK_STOCK_PER_STEP=6             — stock chains polled per sweep step (rate-limit knob)
# KOTAK_QUOTES_CHUNK=25              — instruments per Quotes GET
# KOTAK_LOGIN_BASE=https://gw-napi.kotaksecurities.com
# KOTAK_NAPI_BASE=https://napi.kotaksecurities.com

# --- Upstox (historical backfill only, last ~6mo of expired-options data) ---
# UPSTOX_ACCESS_TOKEN — from account.upstox.com/developer/apps, requires
#                        Upstox Plus plan for the expired-instruments endpoints
# UPSTOX_CLIENT_ID     — your Upstox client code
UPSTOX_ACCESS_TOKEN=
UPSTOX_CLIENT_ID=

# --- ICICI Breeze (historical backfill only, ~6mo-3yr window — see
#     server/breeze-historical/README.md. Isolated on purpose: NOT used for
#     anything live, that stays Angel One only.) ---
# BREEZE_API_KEY     — from api.icicidirect.com (My Apps)
# BREEZE_API_SECRET  — paired secret for the same app
# BREEZE_API_SESSION — EXPIRES DAILY, must be regenerated by hand each time
#                      you run a Breeze backfill — see the README for the
#                      exact login-URL steps, there is no automatic option.
BREEZE_API_KEY=
BREEZE_API_SECRET=
BREEZE_API_SESSION=

# --- Forgot-password email (Phase 12) ---
# Gmail SMTP: SMTP_PASS must be a Gmail "App Password"
# (myaccount.google.com/apppasswords, requires 2-Step Verification on the
# account) — your normal Gmail login password will NOT work, Google blocks
# plain-password SMTP auth entirely.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=            — the 16-character App Password, not your Gmail password
# SMTP_FROM=you@gmail.com   — optional, defaults to SMTP_USER
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# CLIENT_URL — base URL of the client app, used to build the password-reset
# link emailed to users (e.g. https://bazaarsync.com in production).
CLIENT_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bazaar_sync
DB_USER=root
DB_PASSWORD=

# --- Razorpay (Pro subscription purchase + Paper Trade refills, Phase 8.2) ---
# RAZORPAY_KEY_ID/SECRET — from dashboard.razorpay.com (Settings -> API Keys).
# Test-mode keys work fine for development; live keys only for production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Optional tuning (defaults shown) ---
# WORKER_SYMBOLS=NIFTY,BANKNIFTY,FINNIFTY
# WORKER_STRIKES_PER_SIDE=15
# HIST_STRIKES_PER_SIDE=20
# SOCKET_BROADCAST_MS=1000
# TICK_BUFFER_MAX_RECORDS=100
# TICK_BUFFER_FLUSH_MS=2000
# LOG_LEVEL=info
# CORS_ORIGINS=http://localhost:5173
# TRUST_PROXY=true   — set only in production behind nginx (institute IP
#                      allowlist needs the real client IP, not the proxy's)
